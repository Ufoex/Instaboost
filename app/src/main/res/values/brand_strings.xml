<?xml version="1.0" encoding="utf-8"?>
<!--
  Instaboost's own branding strings, kept separate from strings.xml on purpose.
  strings.xml is upstream Instaboost's actively-maintained translation file;
  every branded string we put on the same lines there was a recurring merge-
  conflict magnet on every upstream sync. Android merges all files in a
  values*/ directory together automatically, so this works with zero build
  config changes — just don't redefine these 3 keys in strings.xml again.
-->
<resources>
    <string name="app_name">Instaboost</string>
    <string name="network_error_description">To use Instaboost, turn on mobile data or connect to Wi-Fi.</string>
    <string name="instaboost_settings">Instaboost settings</string>
</resources>
